# Salin menjadi backend/.env lalu isi. Jangan di-commit.

# Wajib, minimal 32 karakter. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
NDT_SECRET_KEY=

# Opsional: lokasi database, gambar, dan laporan (taruh di disk yang dibackup).
# Kosong = backend/data
NDT_DATA_DIR=

# Opsional: origin frontend yang boleh memanggil API, dipisah koma.
# Tidak perlu bila frontend dan API satu domain lewat Nginx (/api).
# Kosong = http://localhost:5173,http://127.0.0.1:5173
NDT_CORS_ORIGINS=
